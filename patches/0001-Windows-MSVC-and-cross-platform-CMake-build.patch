+    TEST_ASSERT(client_get(&c, key, got, sizeof(got), NULL) == 0);
+    TEST_ASSERT_STR_EQ(got, val);
+  }
+
+  client_close(&c);
+  srv_stop(&srv);
+  return 0;
+}
+
+int test_multiversioning_run(void) {
+  RUN_TEST(test_overwriting_same_key);
+  return 0;
+}
