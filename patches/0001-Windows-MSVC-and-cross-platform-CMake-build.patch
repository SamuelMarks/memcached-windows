+    }
+  }
+
+  TEST_ASSERT(client_send_str(&c, "stats slabs\r\n") == 0);
+  while (client_readline(&c, line, sizeof(line)) > 0) {
+    if (strncmp(line, "END", 3) == 0) {
+      break;
+    }
+    if (strstr(line, "active_slabs") != NULL) {
+      has_slabs_active = 1;
+    }
+  }
+
+  TEST_ASSERT(has_slabs_active == 1);
+
+  client_close(&c);
+  srv_stop(&srv);
