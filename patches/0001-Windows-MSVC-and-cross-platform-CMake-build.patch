+
+  TEST_ASSERT(client_send_str(&c, "stats\r\n") == 0);
+  while (client_readline(&c, line, sizeof(line)) > 0) {
+    if (strncmp(line, "END", 3) == 0) {
+      break;
+    }
+    if (strstr(line, "STAT pid ") != NULL)
+      has_pid = 1;
+    if (strstr(line, "STAT uptime ") != NULL)
+      has_uptime = 1;
+    if (strstr(line, "STAT time ") != NULL)
