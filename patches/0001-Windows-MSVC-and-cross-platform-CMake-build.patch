+typedef unsigned __int32 test_uint32_t;
+typedef unsigned __int16 test_uint16_t;
+typedef unsigned __int8 test_uint8_t;
+#else
+#include <stdint.h>
+typedef uint64_t test_uint64_t;
+typedef uint32_t test_uint32_t;
