# Default behavior: let git auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files to normalize
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
LICENSE* text eol=lf

# Enforce CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Enforce LF for patch files
*.patch text eol=lf

# Enforce LF for shell scripts
*.sh text eol=lf
